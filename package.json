{
  "name": "@perfectmemory/ngx-contextmenu-monorepo",
  "version": "21.0.1",
  "description": "Context menu for Angular",
  "keywords": [
    "angular",
    "ngx",
    "ng2",
    "contextmenu",
    "ngx-contextmenu",
    "right click",
    "contextual",
    "shortcut",
    "pop-up",
    "pop-up menu"
  ],
  "contributors": [
    "Isaac Mann <isaacplmann@gmail.com>",
    "Stephane Roucheray <stephane.roucheray@perfect-memory.com>"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com:PerfectMemory/ngx-contextmenu.git"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "nx": "nx",
    "start": "nx serve demo",
    "build:lib": "nx build @perfectmemory/ngx-contextmenu && copyfiles README.md LICENSE.md dist/libs/ngx-contextmenu/",
    "build:doc": "nx build-storybook @perfectmemory/ngx-contextmenu",
    "test": "nx test @perfectmemory/ngx-contextmenu --coverage",
    "ci:test": "nx test @perfectmemory/ngx-contextmenu --watch=false --coverage",
    "pub": "npm run pub:lib && npm run pub:demo",
    "pub:demo": "npm run build:demo -- --base-href /ngx-contextmenu/ && gh-pages -d dist/demo",
    "pub:lib": "npm run build:lib && npm publish ./dist/libs/ngx-contextmenu",
    "pack:lib": "npm run build:lib && cd dist/libs/ngx-contextmenu && npm pack && copyfiles *.tgz ../../ && cd ../.. && rimraf dist/libs/ngx-contextmenu/*.tgz",
    "preversion": "keepachangelog display unreleased && keepachangelog confirm $npm_new_version --current-version $npm_old_version",
    "version": "keepachangelog release $npm_new_version && npm --prefix ./libs/ngx-contextmenu pkg set version=$npm_new_version && git add ./CHANGELOG.md ./libs/ngx-contextmenu/package.json",
    "postversion": "git push origin HEAD && git push origin v$npm_new_version",
    "storybook": "nx storybook @perfectmemory/ngx-contextmenu"
  },
  "dependencies": {
    "@angular/animations": "22.1.0",
    "@angular/cdk": "22.1.1",
    "@angular/common": "22.1.0",
    "@angular/compiler": "22.1.0",
    "@angular/core": "22.1.0",
    "@angular/forms": "22.1.0",
    "@angular/platform-browser": "22.1.0",
    "@angular/platform-browser-dynamic": "22.1.0",
    "@angular/router": "22.1.0",
    "@nx/angular": "23.1.1",
    "browserslist": "^4.28.1",
    "remark-gfm": "^4.0.1",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.1.0",
    "@angular-devkit/core": "22.1.0",
    "@angular-devkit/schematics": "22.1.0",
    "@angular-eslint/eslint-plugin": "22.1.0",
    "@angular-eslint/eslint-plugin-template": "22.1.0",
    "@angular-eslint/template-parser": "22.1.0",
    "@angular/build": "22.1.0",
    "@angular/cli": "22.1.0",
    "@angular/compiler-cli": "22.1.0",
    "@angular/language-service": "22.1.0",
    "@eslint/eslintrc": "^3.0.0",
    "@eslint/js": "^9.8.0",
    "@nx/devkit": "23.1.1",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/jest": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/playwright": "23.1.1",
    "@nx/storybook": "23.1.1",
    "@nx/web": "23.1.1",
    "@nx/workspace": "23.1.1",
    "@openng/spectator": "^1.0.0",
    "@playwright/test": "^1.53.0",
    "@schematics/angular": "22.0.9",
    "@storybook/addon-docs": "^10.1.9",
    "@storybook/angular": "10.5.7",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.23",
    "@types/jest": "30.0.0",
    "@types/node": "^20.19.0",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "@typescript-eslint/type-utils": "^8.66.0",
    "@typescript-eslint/types": "^8.51.0",
    "@typescript-eslint/utils": "8.66.0",
    "@vtabary/keepachangelog-cli": "^0.4.0",
    "angular-eslint": "^22.0.0",
    "autoprefixer": "^10.4.0",
    "copyfiles": "^2.4.1",
    "eslint": "9.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "^0.15.3",
    "eslint-plugin-storybook": "^10.1.9",
    "jest": "30.3.0",
    "jest-environment-jsdom": "30.0.5",
    "jest-preset-angular": "17.0.0",
    "jest-util": "30.0.5",
    "jsonc-eslint-parser": "^2.1.0",
    "ng-packagr": "22.0.2",
    "nx": "23.1.1",
    "postcss": "^8.4.5",
    "postcss-url": "~10.1.3",
    "prettier": "^2.6.2",
    "storybook": "10.5.7",
    "ts-jest": "29.4.9",
    "ts-node": "10.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.58.0"
  }
}
